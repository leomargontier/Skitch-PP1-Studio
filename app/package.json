{
  "name": "skitch-studio",
  "productName": "Skitch Studio",
  "version": "0.1.0",
  "description": "Offline desktop app for the Brother SKITCH PP1 embroidery machine. No account needed.",
  "author": { "name": "leomargontier", "email": "leomargontier@users.noreply.github.com" },
  "repository": "github:leomargontier/embrodery",
  "homepage": "https://github.com/leomargontier/embrodery",
  "license": "MIT",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.skitchstudio.app",
    "files": ["main.cjs", "preload.cjs", "index.html", "style.css", "src/**/*", "build/icon.png"],
    "directories": { "output": "dist" },
    "linux": { "category": "Graphics", "icon": "build/icon.png", "maintainer": "Skitch Studio contributors" },
    "deb": { "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "bluez"] },
    "win": { "icon": "build/icon.png" },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "extendInfo": { "NSBluetoothAlwaysUsageDescription": "Skitch Studio uses Bluetooth to send designs to your SKITCH embroidery machine." }
    }
  }
}
